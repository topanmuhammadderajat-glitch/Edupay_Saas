{
  "name": "edupay-saas-backend",
  "version": "1.0.0",
  "description": "EduPay SaaS Ecosystem - Multi-Tenant School Financial & Midtrans Payment API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx src/seed/seed12Grades.ts",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:integration": "node tests/run-integration.cjs",
    "typecheck": "tsc --noEmit",
    "prisma:deploy": "node scripts/deploy-cloud.mjs",
    "release:check": "node scripts/release-preflight.mjs",
    "test:cloud:isolated": "node scripts/test-cloud-isolated.mjs",
    "prisma:deploy:supabase": "node scripts/deploy-cloud.mjs --supabase",
    "seed:staging": "node scripts/seed-staging.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "midtrans-client": "^1.3.1",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
